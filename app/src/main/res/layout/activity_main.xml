<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF02030A">

    <android.opengl.GLSurfaceView
        android:id="@+id/glPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_top_scrim"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COSMOS STUDIO"
                android:textSize="10.5sp"
                android:letterSpacing="0.22"
                android:textColor="#99A8C0FF"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvPlanetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earth"
                android:textSize="36sp"
                android:fontFamily="sans-serif-thin"
                android:textColor="#FFFFFFFF"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPlanetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3rd Planet • 149.6M km • 24h Day"
                android:textSize="12.5sp"
                android:textColor="#99DCE4FF"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPlanetSpecs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diameter 12,742 km  •  15 °C  •  1 Moon"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp"
                android:background="#1FFFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@+id/btnReplayZoom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle"
                android:src="@drawable/ic_zoom_sparkle"
                android:contentDescription="Replay Unlock Zoom"
                android:padding="10dp"
                android:layout_marginEnd="10dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="@string/open_settings"
                android:padding="10dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/bg_bottom_scrim"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Drag to inspect  •  Pinch to zoom  •  Double-tap to reset"
            android:textSize="11sp"
            android:textColor="#66FFFFFF"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/planetCardContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/set_wallpaper"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:textColor="#FF070A16"
            app:backgroundTint="#FFF4F7FF"
            app:cornerRadius="27dp"
            app:elevation="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
